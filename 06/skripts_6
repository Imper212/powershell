$drivers = Get-CimInstance -ClassName Win32_PnPSignedDriver

$otherDrivers = @()

foreach ($driver in $drivers) {
    if ($driver.DriverProviderName -ne "Microsoft") {
        $otherDrivers += $driver
    }
}

$otherDrivers |
    Select-Object DeviceName, DriverProviderName, DriverVersion |
    Export-Csv -Path "$PSScriptRoot\draiveri.csv" -NoTypeInformation -Encoding UTF8

Write-Output "Rindu skaits CSV faila: $($otherDrivers.Count)"
Write-Output "CSV fails saglabats draiveri.csv"
